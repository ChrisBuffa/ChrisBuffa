// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// ─────────────────────────────────────────────────────────────────────────────
//  Flow Model V3 — Tier-3 reversal confluence model
//
//  A Tier-3 (T3) setup forms when three rejection sources stack inside one
//  tolerance band:
//      1. a volume-profile level  (POC / VAH / VAL / HVN of the 3D, 5D, 7D or Monthly profile)
//      2. a current-session VWAP deviation band (±1σ / ±2σ / ±3σ)
//      3. a manually pasted option level (GEX 1–10, HVL, Call Resistance, Put Support, 1D Max/Min, 0DTE levels)
//
//  S-score = round((profile pts + VWAP band pts + option pts) / 3), −10 once a setup has been used.
//      Profile  : 3D 25 · 5D 50 · 7D 90 · Monthly 100
//      VWAP     : 1σ 50 · 2σ 90 · 3σ 100
//      Options  : HVL, GEX 7–10 = 25 · GEX 4–6, HVL 0DTE = 50 · GEX 2–3 = 90
//                 GEX 1, Call Resistance, Put Support, 1D Max, 1D Min,
//                 Call Resistance 0DTE, Put Support 0DTE, Gamma Wall 0DTE = 100
//  Overlapping T3 setups of the same direction merge into a cluster that shows the highest score.
//  The S-score measures relative confluence strength, not win probability.
// ─────────────────────────────────────────────────────────────────────────────
//@version=6
indicator("Flow Model V3", shorttitle = "Flow Model V3", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500, max_polylines_count = 100)

